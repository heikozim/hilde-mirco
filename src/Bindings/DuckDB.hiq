        end if;
        at := skipSpaces(sql, next);
        next := wordEnd(sql, at, "INTO");
        if next = at then
            return noShape();
        end if;
        let table_start: Index := skipSpaces(sql, next);
        let table_end: Index := nameEnd(sql, table_start);
        if table_end = table_start then
            return noShape();
        end if;
        at := skipSpaces(sql, table_end);
        if not byteAt(sql, at, 40) then
            return noShape();
        end if;
        let list_start: Index := at + 1;
        at := list_start;
        var columns: Index := 0;
        var more: Bool := true;
        while more do
            at := skipSpaces(sql, at);
            next := nameEnd(sql, at);
