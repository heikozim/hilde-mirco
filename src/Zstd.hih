"""
Unpacks frames of Zstandard as RFC 8878 describes them, as the zstd tool writes them and .root files hold them.

- Raw, run-length and compressed blocks; literals raw, repeated or coded by Huffman in one or four streams.
- Sequences coded by finite state entropy with predefined, run-length, described and repeated tables, and the three repeat offsets.
- The checksum of a frame, the low 32 bits of its XXH64, is verified when the frame has one.
- A frame with a dictionary is refused; unpacking stops at the limit the caller names, never with an abort.

    let text: Option[String] := unzstd(packed, 1048576);
"""
import Standard.String (String);

module Mirco.Zstd is
    """
    The bytes the frames of data hold, at most limit of them; None for data that are no such frames.
    No contract: no precondition, since data that are no frames, or that unpack to more than limit bytes, give None.
    """
    generic [R: Region]
    function unzstd(data: Span[Nat8, R], limit: Index): Option[String];

    """
    XXH64 of data with the seed 0, the checksum of a frame of Zstandard and of a block of LZ4.
    No contract: no precondition, since any bytes have a hash, and every Nat64 is a possible result.
    """
    generic [R: Region]
    function xxh64(data: Span[Nat8, R]): Nat64;
end module.
