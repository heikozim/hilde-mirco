--
-- The streams are those tools/make-xz-vectors.py prints, written by
-- liblzma; each with the length and the CRC32 of the bytes it holds.
import Standard.Buffer (Buffer, allocateEmpty, insertBack, destroyFree, wholeSpan, storeNth, nth, length);
import Standard.String (String, asSpan, destroyString, length as stringLength);
import Standard.Gzip (crc32);
import Mirco.Xz (unxz);
import Standard.Testing (assertTrue);

module body Mirco.Xz.Test is
    function nibble(c: Nat8): Nat8 is
        if (c >= 48) and (c <= 57) then
            return c - 48;
        else if (c >= 97) and (c <= 102) then
            return c - 87;
        end if;
        abort("Mirco.Xz.Test: a vector holds a character that is no hex digit");
    end;

    function fromHex(text: Span[Nat8, Static]): Buffer[Nat8] is
        var out: Buffer[Nat8] := allocateEmpty();
        var at: Index := 0;
        while (at + 1) < spanLength(text) do
            let high: Nat8 := nibble(text[at]);
            let low: Nat8 := nibble(text[at + 1]);
            insertBack(&!out, (high * 16) + low);
            at := at + 2;
        end while;
        return out;
    end;

    -- True when the stream unpacks to size bytes of the CRC32 sum.
    generic [R: Region]
    function unpacksTo(stream: &[Buffer[Nat8], R], size: Index, sum: Nat32): Bool is
        case unxz(wholeSpan(stream), 100000) of
            when Some(value as text: String) do
                let good: Bool := (stringLength(&text) = size) and (crc32(asSpan(&text)) = sum);
                destroyString(text);
                return good;
            when None do
                return false;
        end case;
    end;

    generic [R: Region]
    function refused(stream: &[Buffer[Nat8], R]): Bool is
        case unxz(wholeSpan(stream), 100000) of
            when Some(value as text: String) do
                destroyString(text);
                return false;
            when None do
                return true;
        end case;
    end;

    function testMixed(): Unit is
        let s: Buffer[Nat8] := fromHex("fd377a585a0000016922de360200210116000000742fe5a3e0031f00245d00309888ad4b3712a2a29f87170d1ec32e7b6e0093198d33379fa924ec905f9dfe6355200000cea7eb7b00013ca00600000041d3a1e53e300d8b020000000001595a");
        assertTrue(unpacksTo(&s, 800, 2079041486), "800 bytes of repeats");
        destroyFree(s);
        return nil;
    end;

    function testWords(): Unit is
        let s: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&s, 6000, 1446631346), "6000 bytes of words, matches near and far");
        destroyFree(s);
        return nil;
    end;

    function testChecks(): Unit is
        let none: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&none, 300, 2636948943), "a stream without check");
        let wide: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&wide, 500, 1445831745), "a stream with a CRC64, skipped");
        let empty: Buffer[Nat8] := fromHex("fd377a585a0000016922de36000000001cdf44219042990d010000000001595a");
        assertTrue(unpacksTo(&empty, 0, 0), "the empty stream");
        destroyFree(none);
        destroyFree(wide);
        destroyFree(empty);
        return nil;
    end;

    -- A changed byte in the header, in the data and in the check, a cut
    -- stream and a limit below the size are each refused.
    function testRefusals(): Unit is
        var header: Buffer[Nat8] := fromHex("fd377a585a0000016922de360200210116000000742fe5a3e0031f00245d00309888ad4b3712a2a29f87170d1ec32e7b6e0093198d33379fa924ec905f9dfe6355200000cea7eb7b00013ca00600000041d3a1e53e300d8b020000000001595a");
        storeNth(&!header, 7, 4);
        assertTrue(refused(&header), "the flags of the stream changed against their CRC32");
        var content: Buffer[Nat8] := fromHex("");
        let changed: Nat8 := nth(&content, 300) + 1;
        storeNth(&!content, 300, changed);
        assertTrue(refused(&content), "a byte of the data changed");
        var short: Buffer[Nat8] := allocateEmpty();
        let whole: Buffer[Nat8] := fromHex("");
        var at: Index := 0;
        while at < (length(&whole) - 40) do
            insertBack(&!short, nth(&whole, at));
            at := at + 1;
        end while;
        assertTrue(refused(&short), "a stream cut before its index");
        case unxz(wholeSpan(&whole), 1000) of
            when Some(value as text: String) do
                destroyString(text);
                assertTrue(false, "6000 bytes above a limit of 1000");
            when None do
                assertTrue(true, "6000 bytes above a limit of 1000");
        end case;
        destroyFree(header);
        destroyFree(content);
        destroyFree(short);
        destroyFree(whole);
        return nil;
    end;
end module body.
