--
-- The frames are those tools/make-zstd-vectors.py prints, written by the
-- zstd tool 1.5.7; each with the length and the CRC32 of the bytes it holds.
import Standard.Buffer (Buffer, allocateEmpty, insertBack, destroyFree, wholeSpan, storeNth, nth, length);
import Standard.String (String, asSpan, destroyString, length as stringLength);
import Standard.Gzip (crc32);
import Mirco.Zstd (unzstd);
import Standard.Testing (assertTrue);

module body Mirco.Zstd.Test is
    function nibble(c: Nat8): Nat8 is
        if (c >= 48) and (c <= 57) then
            return c - 48;
        else if (c >= 97) and (c <= 102) then
            return c - 87;
        end if;
        abort("Mirco.Zstd.Test: a vector holds a character that is no hex digit");
    end;

    function fromHex(text: Span[Nat8, Static]): Buffer[Nat8] is
        var out: Buffer[Nat8] := allocateEmpty();
        var at: Index := 0;
        while (at + 1) < spanLength(text) do
            let high: Nat8 := nibble(text[at]);
            let low: Nat8 := nibble(text[at + 1]);
            insertBack(&!out, (high * 16) + low);
            at := at + 2;
        end while;
        return out;
    end;

    generic [R: Region]
    function unpacksTo(frame: &[Buffer[Nat8], R], size: Index, sum: Nat32): Bool is
        case unzstd(wholeSpan(frame), 1000000) of
            when Some(value as text: String) do
                let good: Bool := (stringLength(&text) = size) and (crc32(asSpan(&text)) = sum);
                destroyString(text);
                return good;
            when None do
                return false;
        end case;
    end;

    generic [R: Region]
    function refused(frame: &[Buffer[Nat8], R]): Bool is
        case unzstd(wholeSpan(frame), 1000000) of
            when Some(value as text: String) do
                destroyString(text);
                return false;
            when None do
                return true;
        end case;
    end;

    function testSmall(): Unit is
        let short: Buffer[Nat8] := fromHex("28b52ffd045881000068656c6c6f2c207a7374616e646172645f7d2864");
        assertTrue(unpacksTo(&short, 16, 1819571016), "a short text, raw literals");
        let repeats: Buffer[Nat8] := fromHex("28b52ffd04585500001861626301006a67ef86085ab3a4");
        assertTrue(unpacksTo(&repeats, 6000, 3290028393), "6000 bytes of repeats");
        let empty: Buffer[Nat8] := fromHex("28b52ffd240001000099e9d851");
        assertTrue(unpacksTo(&empty, 0, 0), "the empty frame");
        destroyFree(short);
        destroyFree(repeats);
        destroyFree(empty);
        return nil;
    end;

    function testWords(): Unit is
        let words: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&words, 6000, 1446631346), "6000 bytes of words at level 3");
        let strong: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&strong, 20000, 38513660), "20000 bytes at level 19");
        let unchecked: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&unchecked, 3000, 1972575200), "a frame without checksum");
        destroyFree(words);
        destroyFree(strong);
        destroyFree(unchecked);
        return nil;
    end;

    function testBlocks(): Unit is
        let blocks: Buffer[Nat8] := fromHex("");
        assertTrue(unpacksTo(&blocks, 140000, 1872858716), "140000 bytes in more than one block");
        destroyFree(blocks);
        return nil;
    end;

    function testRefusals(): Unit is
        var magic: Buffer[Nat8] := fromHex("");
        storeNth(&!magic, 0, 41);
        assertTrue(refused(&magic), "another magic");
        var content: Buffer[Nat8] := fromHex("");
        let changed: Nat8 := nth(&content, 400) + 1;
        storeNth(&!content, 400, changed);
        assertTrue(refused(&content), "a byte of the data changed, the checksum or the codes break");
        let whole: Buffer[Nat8] := fromHex("");
        var short: Buffer[Nat8] := allocateEmpty();
        var at: Index := 0;
        while at < (length(&whole) - 10) do
            insertBack(&!short, nth(&whole, at));
            at := at + 1;
        end while;
        assertTrue(refused(&short), "a frame cut short");
        case unzstd(wholeSpan(&whole), 1000) of
            when Some(value as text: String) do
                destroyString(text);
                assertTrue(false, "6000 bytes above a limit of 1000");
            when None do
                assertTrue(true, "6000 bytes above a limit of 1000");
        end case;
        destroyFree(magic);
        destroyFree(content);
        destroyFree(short);
        destroyFree(whole);
        return nil;
    end;
end module body.
