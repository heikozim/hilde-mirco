import Standard.Buffer (Buffer, allocateEmpty, insertBack, destroyFree, wholeSpan);
import Mirco.Element (Element);
import Mirco.Array (NdArray, fromSpan, destroyNdArray, count, flatGet);
import Mirco.Fft (
    Signal,
    signal,
    realSignal,
    destroySignal,
    signalLength,
    realAt,
    imaginaryAt,
    magnitude,
    fft,
    inverseFft,
    realFft,
    fftFrequencies
);
import Mirco.Math (absolute);
import Standard.Testing (assertTrue);

module body Mirco.Fft.Test is
    function near(a: Float64, b: Float64): Bool is
        return absolute(a - b) < 0.000000001;
    end;

    generic [R: Region]
    function vectorOf(values: &[Buffer[Float64], R]): NdArray[Float64] is
        var shape: Buffer[Index] := allocateEmpty();
        insertBack(&!shape, spanLength(wholeSpan(values)));
        let made: NdArray[Float64] := fromSpan(wholeSpan(&shape), wholeSpan(values));
        destroyFree(shape);
        return made;
    end;

    -- 1, 2, ..., n as a vector.
    function counting(n: Index): NdArray[Float64] is
        var values: Buffer[Float64] := allocateEmpty();
        var v: Float64 := 1.0;
        var at: Index := 0;
        while at < n do
            insertBack(&!values, v);
            v := v + 1.0;
            at := at + 1;
        end while;
        let made: NdArray[Float64] := vectorOf(&values);
        destroyFree(values);
        return made;
    end;

    -- The transform of 1 2 3 4 is 10, -2 + 2i, -2, -2 - 2i.
    function testPowerOfTwo(): Unit is
        let x: NdArray[Float64] := counting(4);
        let s: Signal := realSignal(&x);
        let t: Signal := fft(&s);
        assertTrue(signalLength(&t) = 4, "four values");
        assertTrue(near(realAt(&t, 0), 10.0) and near(imaginaryAt(&t, 0), 0.0), "X0");
        assertTrue(near(realAt(&t, 1), -2.0) and near(imaginaryAt(&t, 1), 2.0), "X1");
        assertTrue(near(realAt(&t, 2), -2.0) and near(imaginaryAt(&t, 2), 0.0), "X2");
        assertTrue(near(realAt(&t, 3), -2.0) and near(imaginaryAt(&t, 3), -2.0), "X3");
        destroySignal(t);
        destroySignal(s);
        destroyNdArray(x);
        return nil;
    end;

    -- A length of 5 goes through the method of Bluestein; the values are
    -- those of the sum of the definition.
    function testOddLength(): Unit is
        let x: NdArray[Float64] := counting(5);
        let s: Signal := realSignal(&x);
        let t: Signal := fft(&s);
        assertTrue(near(realAt(&t, 0), 15.0), "X0");
        assertTrue(near(realAt(&t, 1), -2.5) and near(imaginaryAt(&t, 1), 3.440954801178), "X1");
        assertTrue(near(realAt(&t, 2), -2.5) and near(imaginaryAt(&t, 2), 0.812299240582), "X2");
        assertTrue(near(imaginaryAt(&t, 4), -3.440954801178), "X4");
        destroySignal(t);
        destroySignal(s);
        destroyNdArray(x);
        return nil;
    end;

    function testSevenAndInverse(): Unit is
        var values: Buffer[Float64] := allocateEmpty();
        insertBack(&!values, 0.5);
        insertBack(&!values, -1.0);
        insertBack(&!values, 2.0);
        insertBack(&!values, 0.0);
        insertBack(&!values, 3.0);
        insertBack(&!values, 1.5);
        insertBack(&!values, -2.5);
        let x: NdArray[Float64] := vectorOf(&values);
        destroyFree(values);
        let s: Signal := realSignal(&x);
        let t: Signal := fft(&s);
        assertTrue(near(realAt(&t, 1), -5.16394417906) and near(imaginaryAt(&t, 1), -0.35855996244), "X1");
        assertTrue(near(realAt(&t, 3), 5.168042542295) and near(imaginaryAt(&t, 3), 2.664873869103), "X3");
        let back: Signal := inverseFft(&t);
        assertTrue(near(realAt(&back, 2), 2.0) and near(imaginaryAt(&back, 2), 0.0), "x2 back");
        assertTrue(near(realAt(&back, 6), -2.5), "x6 back");
        destroySignal(back);
        destroySignal(t);
        destroySignal(s);
        destroyNdArray(x);
        return nil;
    end;

    -- A complex signal of 16 values comes back from the inverse.
    function testRoundTripComplex(): Unit is
        let re: NdArray[Float64] := counting(16);
        let im: NdArray[Float64] := counting(16);
        let s: Signal := signal(&re, &im);
        let t: Signal := fft(&s);
        let back: Signal := inverseFft(&t);
        var good: Index := 0;
        var at: Index := 0;
        while at < 16 do
            if near(realAt(&back, at), realAt(&s, at)) and near(imaginaryAt(&back, at), imaginaryAt(&s, at)) then
                good := good + 1;
            end if;
            at := at + 1;
        end while;
        assertTrue(good = 16, "every value back");
        destroySignal(back);
        destroySignal(t);
        destroySignal(s);
        destroyNdArray(re);
        destroyNdArray(im);
        return nil;
    end;

    function testRealFftAndMagnitude(): Unit is
        let x: NdArray[Float64] := counting(4);
        let half: Signal := realFft(&x);
        assertTrue(signalLength(&half) = 3, "n / 2 + 1 values");
        let m: NdArray[Float64] := magnitude(&half);
        assertTrue(near(flatGet(&m, 0), 10.0), "the sum");
        assertTrue(near(flatGet(&m, 1), 2.8284271247461903), "the absolute of -2 + 2i");
        destroyNdArray(m);
        destroySignal(half);
        destroyNdArray(x);
        return nil;
    end;

    function testFrequencies(): Unit is
        let even: NdArray[Float64] := fftFrequencies(8, 0.1);
        assertTrue(near(flatGet(&even, 1), 1.25) and near(flatGet(&even, 4), -5.0), "eight samples");
        assertTrue(near(flatGet(&even, 7), -1.25), "the last is negative");
        let odd: NdArray[Float64] := fftFrequencies(5, 0.1);
        assertTrue(near(flatGet(&odd, 2), 4.0) and near(flatGet(&odd, 3), -4.0), "five samples");
        assertTrue(count(&odd) = 5, "five frequencies");
        destroyNdArray(even);
        destroyNdArray(odd);
        return nil;
    end;
end module body.
