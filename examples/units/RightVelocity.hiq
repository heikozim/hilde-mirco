--
-- The control of the two refused files: the same calls with the units in
-- their places, which the compiler takes.
import Mirco.Units (Meter, MeterPerSecond, Quantity, add, velocity, meters, seconds);

module body Example.RightVelocity is
    function main(): ExitCode is
        let sum: Quantity[Meter] := add(meters(1.0), meters(2.0));
        let v: Quantity[MeterPerSecond] := velocity(meters(1.0), seconds(2.0));
        return ExitSuccess();
    end;
end module body.
